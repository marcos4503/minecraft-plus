<UserControl x:Class="Minecraft_Plus.Controls.ListItems.OptResPackItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Minecraft_Plus.Controls.ListItems"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="title" TextWrapping="Wrap" Text="Title Place Holder" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <ComboBox x:Name="controlCbx" SelectedIndex="0" Grid.Column="1">
                <ComboBoxItem Content="Desativado"/>
                <ComboBoxItem Content="Ativado"/>
            </ComboBox>
            <Image x:Name="normalInfo" Height="20" Width="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="/Resources/info-icon.png" Cursor="Help" Opacity="0.75" Grid.Column="2" ToolTip="PlaceHolder"/>
            <Image x:Name="errorInfo" Height="20" Width="20" HorizontalAlignment="Right" VerticalAlignment="Center" Source="/Resources/info-error-icon.png" Cursor="Help" Opacity="0.75" Grid.Column="2" ToolTip="Não é possível gerenciar esse Recurso Opcional, no momento."/>
        </Grid>
    </Grid>
</UserControl>
