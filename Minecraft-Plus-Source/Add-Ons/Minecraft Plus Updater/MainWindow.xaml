<Window x:Class="Minecraft_Plus_Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minecraft_Plus_Updater"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        mc:Ignorable="d"
        Title="Minecraft+ Updater" Background="{x:Null}" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight" Topmost="True" WindowStartupLocation="CenterScreen" Foreground="{x:Null}" WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>
        <Storyboard x:Key="ghastFloating" RepeatBehavior="Forever">
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ghastGif" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                <EasingThicknessKeyFrame KeyTime="00:00:00" Value="0,0,48,40"/>
                <EasingThicknessKeyFrame KeyTime="00:00:01.2" Value="0,0,48,30"/>
                <EasingThicknessKeyFrame KeyTime="00:00:02.2" Value="0,0,48,40"/>
            </ThicknessAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Grid Width="720" Height="300">
        <Image x:Name="allayGif" gif:ImageBehavior.AnimatedSource="/Resources/allay.gif" gif:ImageBehavior.AnimationSpeedRatio="1.5" Width="120" Height="120" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Margin="50,24,0,0">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Image x:Name="logo" Width="450" Source="/Resources/minecraft-je.png" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image x:Name="ghastGif" gif:ImageBehavior.AnimatedSource="/Resources/happy-ghast.gif" gif:ImageBehavior.AnimationSpeedRatio="1.5" Width="128" Height="128" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,48,40">
            <Image.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource ghastFloating}" />
                </EventTrigger>
            </Image.Triggers>
        </Image>
    </Grid>
</Window>
